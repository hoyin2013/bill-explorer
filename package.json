{
  "name": "bill-explorer",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:autocomplete": "esbuild src/renderer/lib/autocomplete.ts --bundle --platform=node --format=esm --outfile=dist-autocomplete/autocomplete.mjs",
    "test:ac": "npm run build:autocomplete && node --test test-autocomplete.mjs",
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --external:electron --external:onnxruntime-node --external:jpeg-js --format=cjs --outfile=dist-electron/main.js",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload.js",
    "build:electron": "npm run build:main && npm run build:preload",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:watch": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --external:electron --format=cjs --outdir=dist-electron --watch",
    "preview": "vite preview",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:portable": "npm run build && electron-builder --win portable",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "start": "vite --host"
  },
  "dependencies": {
    "@univerjs/docs-ui": "0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "@univerjs/sheets-ui": "0.25.1",
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.27.0",
    "pinyin-pro": "^3.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.4",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  },
  "build": {
    "asar": false,
    "appId": "com.bill-explorer.app",
    "productName": "账单录入器",
    "copyright": "Copyright (C) 2026 账单录入器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "scripts/**/*",
      "models/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
